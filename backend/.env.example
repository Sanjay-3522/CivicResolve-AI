GEMINI_API_KEY=
# Optional; leave empty for deterministic demo mode.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
DATABASE_URL=sqlite:///./civicresolve.db
UPLOAD_DIR=./uploads
FRONTEND_URL=http://localhost:3000
# REQUIRED. The backend refuses to start without it (min 16 chars). Never commit a real value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Optional: admin session lifetime in seconds (default 8h)
# ADMIN_SESSION_TTL_SECONDS=28800
